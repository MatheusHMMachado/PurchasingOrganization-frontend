# Variaveis (definidas no servico do Railway):
#   PORT            porta publica (o Railway injeta)
#   BACKEND_URL     http://<backend>.railway.internal:<porta> (rede privada)
#   INTERNAL_TOKEN  segredo enviado ao backend em X-Internal-Token
{
	admin off
	auto_https off
	servers {
		# O Railway termina o HTTPS; confia no X-Forwarded-* dele
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	encode zstd gzip

	# API: repassada ao backend pela rede privada. O header e sempre sobrescrito,
	# entao um cliente nao consegue forjar o token.
	handle /api/* {
		reverse_proxy {$BACKEND_URL} {
			header_up X-Internal-Token "{$INTERNAL_TOKEN}"
			header_up -X-Forwarded-Host
		}
	}

	# PWA
	handle {
		root * /srv

		# O service worker, o manifesto e o index.html precisam ser revalidados
		# sempre, senao o aviso de "Nova versao" nunca aparece
		@revalidate path /sw.js /registerSW.js /manifest.webmanifest /index.html /
		header @revalidate Cache-Control "no-cache"

		# Arquivos com hash no nome podem ficar em cache para sempre
		header /assets/* Cache-Control "public, max-age=31536000, immutable"

		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
			-Server
		}

		# Rotas do React Router (/batches/1, /share...) caem no index.html
		try_files {path} /index.html
		file_server
	}
}
